# Copy this file to .env in the same directory (V_2.0/) and fill in real secrets.
# docker-compose.yml reads this file automatically.

# --- Postgres ---
POSTGRES_DB=veye
POSTGRES_USER=veye
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Celery (defaults to REDIS_URL if unset) ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Django ---
# Also signs every JWT (HS256), so use 32+ random bytes. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
JWT_COOKIE_SECURE=false

# --- Next.js ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Bulk print (چاپ لیست): max PDFs per ZIP (optional, default 200) ---
# BULK_PRINT_MAX_FILES=200

# --- First-run setup: no token. POST /setup/bootstrap/ creates the first مدیر عامل only while none
# exists; a signed-in مدیر عامل starts with «شروع راه‌اندازی». Attempts are rate-limited per IP. ---
# SETUP_RATELIMIT_RATE=5/m

# --- Organisation chart: max nodes GET /org/tree/ returns at once (optional, default 2000) ---
# ORG_TREE_MAX_NODES=2000

# --- Chat: per-user limit on opening a new DM (optional, default 30/m) ---
# CHAT_OPEN_DIRECT_RATELIMIT_RATE=30/m
# Per-user limit on sending messages, and message page sizes (?before= / ?after=):
# CHAT_SEND_RATELIMIT_RATE=60/m
# CHAT_PAGE_SIZE=50
# CHAT_MAX_PAGE_SIZE=200

# --- کارتابل: an open ریزهدف counts as «منتظر اقدام» from this many days before its deadline (default 3) ---
# INBOX_DUE_SOON_DAYS=3
