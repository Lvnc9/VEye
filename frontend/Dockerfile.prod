# Production image: a compiled Next.js app served by `next start`.
# The dev image (Dockerfile) runs `next dev` with the source bind-mounted instead.
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --fetch-retries=10 --fetch-retry-mintimeout=5000 --fetch-timeout=120000
COPY . .
# The API's public URL is compiled into the browser bundle.
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build && npm prune --omit=dev

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/package*.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/next.config.ts ./
EXPOSE 3000
CMD ["npx", "next", "start", "-H", "0.0.0.0", "-p", "3000"]
