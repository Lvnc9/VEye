# Copy to backend/.env for local (non-docker-compose) development.
# In docker-compose, the top-level V_2.0/.env feeds these same names in
# via the `backend` service's env_file/environment (see ../docker-compose.yml).

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

DATABASE_URL=postgres://veye:change-me@localhost:5432/veye
REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Base URL the frontend hosts /validate/<token> on — embedded in generated
# QR codes (skeleton.md §2/§8.1).
FRONTEND_BASE_URL=http://localhost:3000

LOGIN_RATELIMIT_RATE=10/m
