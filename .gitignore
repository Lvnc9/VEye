# --- Secrets & local configuration (never commit) -------------------------
.env
.env.*
!.env.example
*.pem

# --- OS / editor noise ------------------------------------------------------
.DS_Store
.idea/
.vscode/

# --- Local state -------------------------------------------------------------
# Uploaded files, built PDFs, logos, signatures (docker volume in dev).
backend/media/
# V_1.0 data staged for the importer (real documents, signatures, names).
import_data/
# Stray SQLite files from early test runs.
*.db
*.sqlite3
# Per-machine Claude Code permission settings.
.claude/settings.local.json

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
/staticfiles/

# --- Node / Next.js (frontend/.gitignore covers the rest) -------------------
node_modules/
.next/
*.tsbuildinfo
